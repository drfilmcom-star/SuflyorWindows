<Window x:Class="SuflyorWindows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Суфлёр Windows" Height="760" Width="1120" MinHeight="560" MinWidth="820"
 WindowStartupLocation="CenterScreen" Background="#171A20" Foreground="#F2F4F8">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,14">
   <TextBlock Text="СУФЛЁР" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
    <Button x:Name="OpenButton" Content="Открыть DOCX / TXT" Click="OpenButton_Click" Padding="14,8" Margin="8,0"/>
    <Button x:Name="ShowOutputButton" Content="Окно ведущего" Click="ShowOutputButton_Click" Padding="14,8" Margin="8,0"/>
    <Button x:Name="StartVoiceButton" Content="Начать распознавание" Click="StartVoiceButton_Click" Padding="14,8" Margin="8,0"/>
    <Button x:Name="StopVoiceButton" Content="Остановить" Click="StopVoiceButton_Click" Padding="14,8" Margin="8,0" IsEnabled="False"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#222731" CornerRadius="8" Padding="12" Margin="0,0,12,0">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="ТЕКСТ СЦЕНАРИЯ. Разделители блоков: пустая строка или -----" Foreground="#AAB4C4" Margin="0,0,0,10"/>
     <TextBox x:Name="ScriptBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
       FontSize="17" Background="#222731" Foreground="#F2F4F8" BorderThickness="0"
       TextChanged="ScriptBox_TextChanged"/>
    </DockPanel>
   </Border>
   <Border Grid.Column="1" Background="#222731" CornerRadius="8" Padding="16">
    <StackPanel>
     <TextBlock Text="УПРАВЛЕНИЕ" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>
     <TextBlock Text="Текущий блок" Foreground="#AAB4C4"/>
     <TextBlock x:Name="BlockLabel" Text="1" FontSize="28" FontWeight="Bold" Margin="0,2,0,16"/>
     <Button Content="Суфлёр заново" Click="ResetBlockButton_Click" Padding="12,10" Margin="0,0,0,10"/>
     <Button Content="Показать / обновить текст" Click="RefreshOutputButton_Click" Padding="12,10" Margin="0,0,0,20"/>
     <Separator Background="#454D5B" Margin="0,0,0,16"/>
     <TextBlock Text="Аудиовход" Foreground="#AAB4C4" Margin="0,0,0,5"/>
     <ComboBox x:Name="AudioDeviceBox" MinHeight="32" Margin="0,0,0,12"/>
     <Button Content="Обновить список устройств" Click="RefreshAudioDevices_Click" Padding="10,7" Margin="0,0,0,12"/>
     <TextBlock x:Name="SpeechStatus" Text="Распознавание выключено" TextWrapping="Wrap" Foreground="#8FCBFF" Margin="0,0,0,10"/>
     <TextBlock x:Name="RecognizedText" Text="Здесь появится распознанная речь" TextWrapping="Wrap" Foreground="#AAB4C4" Margin="0,0,0,14"/>
     <TextBlock Text="Окно ведущего предназначено для отдельного монитора с телесуфлёрным стеклом." TextWrapping="Wrap" Foreground="#AAB4C4"/>
     <TextBlock Text="Распознавание речи выполняется локально, без облачных сервисов." TextWrapping="Wrap" Foreground="#AAB4C4" Margin="0,10,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="Windows 10/11 x64 • прототип • .NET 8" Foreground="#8993A3" Margin="2,12,0,0"/>
 </Grid>
</Window>
