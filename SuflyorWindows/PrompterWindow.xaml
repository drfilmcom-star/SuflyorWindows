 <Window x:Class="SuflyorWindows.PrompterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Суфлёр — окно ведущего" Width="1000" Height="700" Background="#101114" Foreground="White"
 WindowStartupLocation="Manual" KeyDown="Window_KeyDown">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#1D2026" Padding="10">
   <DockPanel>
    <TextBlock x:Name="BlockHeader" Text="БЛОК 1" FontSize="15" FontWeight="Bold" Foreground="#8FCBFF" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
     <TextBlock Text="Скорость" VerticalAlignment="Center" Margin="8,0"/>
     <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="2.5" Value="1" Width="105" VerticalAlignment="Center" ValueChanged="SpeedSlider_ValueChanged"/>
     <Button x:Name="StartScrollButton" Content="Старт" Click="StartScroll_Click" Margin="6,0" Padding="10,4"/>
     <Button x:Name="StopScrollButton" Content="Стоп" Click="StopScroll_Click" Margin="3,0" Padding="10,4" IsEnabled="False"/>
     <CheckBox x:Name="MirrorCheck" Content="Зеркало" Foreground="White" VerticalAlignment="Center" Margin="8,0" Checked="MirrorCheck_Changed" Unchecked="MirrorCheck_Changed"/>
     <Button Content="A−" Click="Smaller_Click" Margin="3,0" Padding="10,4"/>
     <Button Content="A+" Click="Larger_Click" Margin="3,0" Padding="10,4"/>
     <Button Content="На весь экран" Click="Fullscreen_Click" Margin="3,0" Padding="10,4"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer x:Name="TextScroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="7,30,7,50">
   <TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="42" LineHeight="58" TextAlignment="Center" Foreground="#FFFFFF" RenderTransformOrigin="0.5,0.5">
    <TextBlock.RenderTransform><ScaleTransform x:Name="TextMirror" ScaleX="1" ScaleY="1"/></TextBlock.RenderTransform>
   </TextBlock>
  </ScrollViewer>
 </Grid>
</Window>